@model CategoryViewModel
@{
    ViewData["Title"] = "Category Page";
}

<div class="container mt-4">

    @await Html.PartialAsync("ExchangeRate", Model.TipoCambio)

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Categories</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Category
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Category ID</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Last Modified</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            foreach (var item in Model.Categories)
                            {
                                <tr>
                                    <td>@item.CategoryId</td>
                                    <td><strong>@item.CategoryName</strong></td>
                                    <td>@item.Description</td>
                                    <td>@(item.LastModified?.ToString("yyyy-MM-dd HH:mm"))</td>
                                    <td>@item.ModifiedBy</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-sm btn-info">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">No categories found.</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>