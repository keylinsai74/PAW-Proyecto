@model NotificationViewModel
@{
    ViewData["Title"] = "Notification Page";
}

<div class="container mt-4">

    @await Html.PartialAsync("ExchangeRate", Model.TipoCambio)

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notifications</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Notification
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>User ID</th>
                            <th>Message</th>
                            <th>Is Read</th>
                            <th>Created At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Notifications != null && Model.Notifications.Any())
                        {
                            foreach (var item in Model.Notifications)
                            {
                                <tr>

                                    <td>
                                        @item.Id
                                    </td>

                                    <td>
                                        @item.UserId
                                    </td>

                                    <td>
                                        @item.Message
                                    </td>

                                    <td>
                                        @if (item.IsRead == true)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                        }
                                        else if (item.IsRead == false)
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>

                                    <td>
                                        @(item.CreatedAt?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">
                                    No notifications found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>